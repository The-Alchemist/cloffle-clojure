<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bootstrap POM: Maven translation of build.xml (no Ant dependency).
  Run with: mvn -f pom-bootstrap.xml test
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.clojure</groupId>
  <artifactId>clojure</artifactId>
  <name>clojure</name>
  <packaging>jar</packaging>
  <version>1.13.0-master-SNAPSHOT</version>
  <description>Clojure core environment and runtime library.</description>

  <properties>
    <directlinking>true</directlinking>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.clojure</groupId>
      <artifactId>spec.alpha</artifactId>
      <version>0.5.238</version>
    </dependency>
    <dependency>
      <groupId>org.clojure</groupId>
      <artifactId>core.specs.alpha</artifactId>
      <version>0.4.74</version>
    </dependency>
    <dependency>
      <groupId>org.clojure</groupId>
      <artifactId>test.generative</artifactId>
      <version>1.1.0</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.clojure</groupId>
          <artifactId>clojure</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.clojure</groupId>
      <artifactId>test.check</artifactId>
      <version>1.1.1</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.clojure</groupId>
          <artifactId>clojure</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.clojure</groupId>
      <artifactId>tools.namespace</artifactId>
      <version>1.4.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>javax.xml.ws</groupId>
      <artifactId>jaxws-api</artifactId>
      <version>2.3.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.mikera</groupId>
      <artifactId>clojure-utils</artifactId>
      <version>0.8.0</version>
    </dependency>
    <dependency>
      <groupId>org.clojure</groupId>
      <artifactId>tools.analyzer.jvm</artifactId>
      <version>1.3.4</version>
    </dependency>
    <dependency>
      <groupId>org.graalvm.truffle</groupId>
      <artifactId>truffle-dsl-processor</artifactId>
      <version>25.0.2</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.graalvm.truffle</groupId>
      <artifactId>truffle-api</artifactId>
      <version>25.0.2</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.12</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>1.7.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/resources</directory>
        <filtering>true</filtering>
      </resource>
      <resource>
        <directory>src/clj</directory>
      </resource>
    </resources>
    <testResources>
      <testResource>
        <directory>test</directory>
        <excludes>
          <exclude>java/**</exclude>
        </excludes>
      </testResource>
    </testResources>
    <sourceDirectory>src/jvm</sourceDirectory>
    <testSourceDirectory>test/java</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>add-main-java</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src/main/java</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-test-java</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src/test/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <source>17</source>
          <target>17</target>
          <encoding>UTF-8</encoding>
          <annotationProcessorPaths>
            <path>
              <groupId>org.graalvm.truffle</groupId>
              <artifactId>truffle-dsl-processor</artifactId>
              <version>25.0.2</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!-- Compile Clojure namespaces (replaces build.xml compile-clojure) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>compile-clojure</id>
            <phase>process-classes</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>java</executable>
              <classpathScope>compile</classpathScope>
              <additionalClasspathElements>
                <additionalClasspathElement>${project.build.outputDirectory}</additionalClasspathElement>
              </additionalClasspathElements>
              <arguments>
                <argument>-Dclojure.compile.path=${project.build.outputDirectory}</argument>
                <argument>-Dclojure.compiler.direct-linking=true</argument>
                <argument>-Djava.awt.headless=true</argument>
                <argument>clojure.lang.Compile</argument>
                <argument>clojure.core</argument>
                <argument>clojure.core.protocols</argument>
                <argument>clojure.core.server</argument>
                <argument>clojure.main</argument>
                <argument>clojure.set</argument>
                <argument>clojure.edn</argument>
                <argument>clojure.xml</argument>
                <argument>clojure.zip</argument>
                <argument>clojure.inspector</argument>
                <argument>clojure.walk</argument>
                <argument>clojure.stacktrace</argument>
                <argument>clojure.template</argument>
                <argument>clojure.test</argument>
                <argument>clojure.test.tap</argument>
                <argument>clojure.test.junit</argument>
                <argument>clojure.pprint</argument>
                <argument>clojure.java.io</argument>
                <argument>clojure.repl</argument>
                <argument>clojure.java.browse</argument>
                <argument>clojure.java.javadoc</argument>
                <argument>clojure.java.shell</argument>
                <argument>clojure.java.process</argument>
                <argument>clojure.java.browse-ui</argument>
                <argument>clojure.java.basis.impl</argument>
                <argument>clojure.java.basis</argument>
                <argument>clojure.string</argument>
                <argument>clojure.data</argument>
                <argument>clojure.reflect</argument>
                <argument>clojure.datafy</argument>
                <argument>clojure.instant</argument>
                <argument>clojure.uuid</argument>
                <argument>clojure.core.reducers</argument>
                <argument>clojure.math</argument>
                <argument>clojure.tools.deps.interop</argument>
                <argument>clojure.repl.deps</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Compile test Clojure namespaces (replaces build.xml compile-tests) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>compile-test-clojure</id>
            <phase>test-compile</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>java</executable>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>-Dclojure.compile.path=${project.build.testOutputDirectory}</argument>
                <argument>-Dclojure.compiler.direct-linking=${directlinking}</argument>
                <argument>clojure.lang.Compile</argument>
                <argument>clojure.test-clojure.protocols.examples</argument>
                <argument>clojure.test-clojure.proxy.examples</argument>
                <argument>clojure.test-clojure.genclass.examples</argument>
                <argument>clojure.test-clojure.compilation.load-ns</argument>
                <argument>clojure.test-clojure.annotations</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Skip Surefire; we run Clojure tests via exec -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <skipTests>true</skipTests>
        </configuration>
      </plugin>
      <!-- Run Clojure tests (replaces build.xml test-example and test-generative) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>test-example</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>java</executable>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>-Dclojure.test-clojure.exclude-namespaces=#{clojure.test-clojure.compilation.load-ns clojure.test-clojure.ns-libs-load-later}</argument>
                <argument>-Dclojure.compiler.direct-linking=${directlinking}</argument>
                <argument>clojure.main</argument>
                <argument>src/script/run_test.clj</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>test-generative</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>java</executable>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>-Dclojure.compiler.direct-linking=${directlinking}</argument>
                <argument>clojure.main</argument>
                <argument>src/script/run_test_generative.clj</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <repositories>
    <repository>
      <id>clojars.org</id>
      <url>https://repo.clojars.org</url>
    </repository>
  </repositories>
</project>
