# syntax=docker/dockerfile:1.7
# Multi-stage build for Cloffle REPL
# Stage 1: GraalVM JDK 25 + Clojure CLI; deps.edn :build supplies tools.build
# Stage 2: Minimal GraalVM 25 runtime (matches deps.edn truffle 25.0.2)

# --- Stage 1: Builder ---
FROM ghcr.io/graalvm/graalvm-community:25 AS builder

# Oracle Linux 10: curl + git for Clojure CLI install and deps; tools.build comes from :build alias
RUN microdnf install -y curl git gzip tar findutils \
    && microdnf clean all \
    && curl -fsSL -o /tmp/linux-install.sh https://github.com/clojure/brew-install/releases/latest/download/linux-install.sh \
    && chmod +x /tmp/linux-install.sh \
    && /tmp/linux-install.sh \
    && rm -f /tmp/linux-install.sh

WORKDIR /workspace

COPY deps.edn build.clj ./
COPY src ./src

RUN --mount=type=cache,target=/root/.m2/repository \
    clojure -T:build jar

RUN --mount=type=cache,target=/root/.m2/repository \
    mkdir -p /build/app && \
    cp "$(cat target/jar-artifact.txt)" /build/app/cloffle.jar && \
    cp -r /root/.m2/repository /build/repository

# Classpath: app jar + repository only (no test dir - CDS cannot dump with directory entries).
# Paths are for runtime (stage 3 WORKDIR /app). java.body.args: @argfile body (JDK 9+): -cp on its
# own line, then one colon-separated classpath line (same pattern as Dockerfile).
RUN --mount=type=cache,target=/root/.m2/repository \
    echo '/app/cloffle.jar' > /build/classpath.txt && \
    clojure -Spath -M:repl | tr ':' '\n' | sed 's|^/root/.m2/repository/|repository/|' | grep '^repository/' >> /build/classpath.txt && \
    { echo '--enable-native-access=ALL-UNNAMED'; \
      echo '--sun-misc-unsafe-memory-access=allow'; \
      echo '-cp'; \
      paste -sd: /build/classpath.txt; \
    } > /build/java.body.args

# --- Stage 2: jlink (GraalVM) ---
FROM ghcr.io/graalvm/graalvm-community:25 AS jlinker

WORKDIR /build

COPY --from=builder /build /build

# Required modules (incl. jdk.internal.vm.ci for CDS option match with Graal/Truffle)
RUN jlink --add-modules java.base,java.desktop,java.logging,java.management,jdk.compiler,java.sql,jdk.unsupported,jdk.internal.vm.ci,org.graalvm.collections,org.graalvm.nativeimage \
      --output /runtime \
      --strip-debug \
      --no-man-pages \
      --no-header-files \
      --compress=zip-9


# Pre-generate CDS archive for this runtime (jlink images don't ship one).
# CDS requires identical root module set at dump and run. GraalVM/JVMCI adds jdk.internal.vm.ci
# at runtime if not present at dump, causing: "Mismatched values for property jdk.module.addmods:
# jdk.internal.vm.ci specified during runtime but not during dump time". We add the module at
# dump so it matches runtime. See: JDK-8345826, JDK-8356189 (bugs.openjdk.org).
RUN /runtime/bin/java --enable-native-access=ALL-UNNAMED -Xshare:dump -Xmx128m --add-modules=jdk.internal.vm.ci

# --- Stage 3: Minimal runtime ---
FROM oraclelinux:10-slim

RUN microdnf install ca-certificates && microdnf clean all


WORKDIR /app

COPY --from=builder /build/app/cloffle.jar /app/cloffle.jar
COPY --from=builder /build/repository /app/repository
COPY --from=builder /build/classpath.txt /app/classpath.txt
COPY --from=builder /build/java.body.args /app/java.body.args
COPY --from=jlinker /runtime /opt/java

ENV JAVA_HOME=/opt/java
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Final @argfile: dynamic CDS (JDK 19+): create/use app.jsa via SharedArchiveFile; AutoCreateSharedArchive
# writes the archive at VM exit when missing or incompatible. Then body from builder (native-access,
# sun-misc, -cp + classpath). Main class is not in the file (see ENTRYPOINT).
# Module set must match at dump and run (JDK-8345826, JDK-8356189).
RUN { echo '-XX:+AutoCreateSharedArchive'; echo '-XX:SharedArchiveFile=/app/app.jsa'; cat /app/java.body.args; } > /app/java.args

# Training run: same argv as ENTRYPOINT so AppCDS archive matches production; app.jsa absent here,
# so AutoCreateSharedArchive dumps at exit.
RUN printf ':quit\n' | java @/app/java.args net.javacrumbs.cloffle.CloffleRepl

ENTRYPOINT ["java", "@/app/java.args", "net.javacrumbs.cloffle.CloffleRepl"]
