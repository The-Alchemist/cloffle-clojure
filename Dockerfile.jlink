# Multi-stage build for Cloffle REPL with jlink (smaller runtime)
# Stage 1: Build | Stage 2: jlink custom runtime | Stage 3: Minimal final image
#
# Uses jlink to create a custom JRE with only required modules (no javac, jshell, etc.).
# Run: docker build -f Dockerfile.jlink -t cloffle-repl:jlink .



# --- Stage 1: Builder ---
FROM clojure:temurin-25-tools-deps AS builder

WORKDIR /workspace

COPY deps.edn build.clj ./
COPY src ./src

RUN clj -T:build build-jar

RUN mkdir -p /build/app && \
    cp target/clojure-*.jar /build/app/cloffle.jar && \
    cp -r /root/.m2/repository /build/repository

# Classpath: app jar + repository only (no test dir - CDS cannot dump with directory entries)
RUN echo 'cloffle.jar' > /build/classpath.txt && \
    clj -Spath -M:repl | tr ':' '\n' | sed 's|^/root/.m2/repository/|repository/|' | grep '^repository/' >> /build/classpath.txt

# --- Stage 2: jlink (GraalVM) ---
FROM ghcr.io/graalvm/jdk-community:25 AS jlinker

WORKDIR /build

COPY --from=builder /build /build

# Required modules (incl. jdk.internal.vm.ci for CDS option match with Graal/Truffle)
RUN jlink --add-modules java.base,java.desktop,java.logging,java.management,jdk.compiler,java.sql,jdk.unsupported,jdk.internal.vm.ci,org.graalvm.collections,org.graalvm.nativeimage \
      --output /runtime \
      --strip-debug \
      --no-man-pages \
      --no-header-files \
      --compress=zip-9


# Pre-generate CDS archive for this runtime (jlink images don't ship one).
# CDS requires identical root module set at dump and run. GraalVM/JVMCI adds jdk.internal.vm.ci
# at runtime if not present at dump, causing: "Mismatched values for property jdk.module.addmods:
# jdk.internal.vm.ci specified during runtime but not during dump time". We add the module at
# dump so it matches runtime. See: JDK-8345826, JDK-8356189 (bugs.openjdk.org).
RUN /runtime/bin/java --enable-native-access=ALL-UNNAMED -Xshare:dump -Xmx128m --add-modules=jdk.internal.vm.ci

# --- Stage 3: Minimal runtime ---
FROM oraclelinux:10-slim

RUN microdnf install ca-certificates && microdnf clean all


WORKDIR /app

COPY --from=builder /build/app/cloffle.jar /app/cloffle.jar
COPY --from=builder /build/repository /app/repository
COPY --from=builder /build/classpath.txt /app/classpath.txt
COPY --from=jlinker /runtime /opt/java

ENV JAVA_HOME=/opt/java
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Java 9+ @file args (one arg per line). -cp needs a single colon-separated line.
# App CDS: same options at dump and runtime (no --enable-native-access to avoid CDS mismatch).
# Module set must match at dump and run (JDK-8345826, JDK-8356189; bugs.openjdk.org).
RUN CP=$(tr '\n' ':' < /app/classpath.txt | sed 's/:$//') && \
    { echo '-XX:SharedArchiveFile=/app/app.jsa'; echo '-cp'; echo "$CP"; echo 'net.javacrumbs.cloffle.CloffleREPL'; } > /app/java.args

# Training run: same JVM options as runtime (no native-access) so CDS archive is accepted.
RUN CP=$(tr '\n' ':' < /app/classpath.txt | sed 's/:$//') && \
    printf ':quit\n' | java --enable-native-access=ALL-UNNAMED -XX:ArchiveClassesAtExit=/app/app.jsa -cp "$CP" net.javacrumbs.cloffle.CloffleREPL

ENTRYPOINT ["/bin/sh", "-c", "exec java --enable-native-access=ALL-UNNAMED @/app/java.args \"$@\"", "--"]
